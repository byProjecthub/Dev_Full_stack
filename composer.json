{
  "name": "vueports/vueports-solutions",
  "description": "Vueports Solutions PHP application for Neon PostgreSQL",
  "type": "project",
  "license": "proprietary",
  "require": {
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "php": "^8.3",
    "phpmailer/phpmailer": "^6.10"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "db:migrate": "php scripts/migrate.php",
    "db:check": "php scripts/check-database.php"
  }
}
