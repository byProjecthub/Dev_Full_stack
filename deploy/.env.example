APP_ENV=development
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Johannesburg
# Paste the complete Neon pooled URI from Connect, including its TLS parameters.
DATABASE_URL=
# Paste the direct URI (connection pooling off) for install / administration commands.
DATABASE_URL_UNPOOLED=
# Alternatively set PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE.
PGSSLMODE=require
SESSION_DRIVER=database
SESSION_SECURE=0
SESSION_LIFETIME=120
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Vueports Solutions
SMTP_REPLY_TO=
# Optional CLI administrator creation. Never commit actual values.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# For compose.deploy.yml with an immutable published image
IMAGE_TAG=
APP_PORT=8080
GHCR_OWNER=byprojecthub
GHCR_REPOSITORY=dev_full_stack
