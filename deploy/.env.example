# GHCR image names must be lowercase. Use the same commit tag for both images.
GHCR_OWNER=byprojecthub
GHCR_REPOSITORY=dev_full_stack
IMAGE_TAG=
APP_URL=https://your-domain.example
APP_PORT=8080
# Generate independent private values on the deployment host.
MYSQL_ROOT_PASSWORD=
MYSQLPASSWORD=
JWT_SECRET=
# HTTPS terminates at the host's reverse proxy.
SESSION_SECURE=1
